@page
@model CarMark.Pages.CarListaModel
@{
    ViewData["Title"] = "Car catalog";
    <link rel="stylesheet" href="~/css/Catalog.css" asp-append-version="true" />
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoCatalog</title>
</head>
<body>

    <div class="layout">

        <aside>
            <div class="sidebar-heading">Filters</div>

            <form method="get" id="filterForm">

                <div class="fg">
                    <label>Make</label>
                    <div class="sel-wrap">
                        <select name="FilterCompany" class="ctrl">
                            <option value="">All makes</option>
                            @foreach (var c in Model.Companies)
                            {
                                <option value="@c" selected="@(Model.FilterCompany == c ? "selected" : null)">@c</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="fg">
                    <label>Model</label>
                    <input type="text" name="FilterModel" class="ctrl"
                           placeholder="Ex: Civic, Gol, Hilux..."
                           value="@Model.FilterModel" />
                </div>

                <div class="fg">
                    <label>Price range (R$)</label>
                    <div class="price-row">
                        <input type="number" name="MinPrice" class="ctrl"
                               placeholder="Minimum" value="@Model.MinPrice"
                               min="0" step="1" />
                        <input type="number" name="MaxPrice" class="ctrl"
                               placeholder="Maximum" value="@Model.MaxPrice"
                               min="0" step="1" />
                    </div>
                </div>

                <button type="submit" class="btn-apply">Search</button>
                <button type="button" class="btn-clear" onclick="clearFilters()">Clear filters</button>

            </form>
        </aside>

        <main>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="err">Warning: @Model.ErrorMessage</div>
            }

            <div class="top-bar">
                <h1>Vehicle catalog</h1>
                <span>@Model.Cars.Count result(s)</span>
            </div>

            @{
                bool hasFilters = !string.IsNullOrEmpty(Model.FilterCompany)
                               || !string.IsNullOrEmpty(Model.FilterModel)
                               || Model.MinPrice.HasValue || Model.MaxPrice.HasValue
                               || !string.IsNullOrEmpty(Model.FilterUsed);
            }
            @if (hasFilters)
            {
                <div class="chips">
                    @if (!string.IsNullOrEmpty(Model.FilterCompany))
                    {
                        <div class="chip"><em>Make:</em> @Model.FilterCompany</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.FilterModel))
                    {
                        <div class="chip"><em>Model:</em> @Model.FilterModel</div>
                    }
                    @if (Model.MinPrice.HasValue)
                    {
                        <div class="chip"><em>Min:</em> R$ @Model.MinPrice.Value.ToString("N0")</div>
                    }
                    @if (Model.MaxPrice.HasValue)
                    {
                        <div class="chip"><em>Max:</em> R$ @Model.MaxPrice.Value.ToString("N0")</div>
                    }
                    @if (Model.FilterUsed == "true")
                    {
                        <div class="chip">Used</div>
                    }
                    @if (Model.FilterUsed == "false")
                    {
                        <div class="chip">New</div>
                    }
                </div>
            }

            <div class="grid">
                @if (!Model.Cars.Any())
                {
                    <div class="empty">
                        <div class="empty-icon">Car</div>
                        <h2>No cars found</h2>
                        <p>Try adjusting the filters to see more results.</p>
                    </div>
                }
                else
                {
                    @foreach (var car in Model.Cars)
                    {
                        <a class="card" asp-page="/CarDetails" asp-route-id="@car.Id">
                            <div class="card-img-wrap">
                                @if (!string.IsNullOrEmpty(car.Image))
                                {
                                    <img src="@car.Image"
                                         alt="@car.Company @car.Model"
                                         class="card-img"
                                         onerror="this.closest('.card-img-wrap').classList.add('card-img--fallback')" />
                                }
                                else
                                {
                                    <div class="card-img--fallback">
                                        <span>Car</span>
                                    </div>
                                }
                            </div>

                            <div class="card-body">
                                <div class="card-brand">@car.Company</div>
                                <div class="card-model">@car.Model</div>
                                <div class="card-tags">
                                    <span class="tag tag-yr">@car.Year</span>
                                    <span class="tag @(car.Used ? "tag-used" : "tag-new")">
                                        @(car.Used ? "Used" : "New")
                                    </span>
                                </div>
                                <div class="card-price-lbl">Price</div>
                                <div class="card-price">R$ @car.Price.ToString("N0")</div>
                            </div>
                        </a>
                    }
                }
            </div>

        </main>
    </div>

    <script src="~/js/CarLista.js" asp-append-version="true"></script>

</body>
</html>
