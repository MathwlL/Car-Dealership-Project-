@page "/login"
@model CarMark.Pages.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<link rel="stylesheet" href="~/css/OwnerCar.css" asp-append-version="true" />
<section class="owner-page"><div class="owner-shell"><div class="owner-heading"><p>CarMark</p><h1>Sign in to your account</h1><span>Access your listings and continue buying or selling vehicles.</span></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice notice-error">@Model.ErrorMessage</div> }
<form method="post" class="owner-form"><input type="hidden" asp-for="ReturnUrl" /><div class="form-grid"><label>Email<input asp-for="Input.Email" type="email" autocomplete="email" placeholder="you@example.com" /></label><label>Password<input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Your password" /></label></div><div class="form-actions"><a asp-page="/Register" class="btn-secondary">Create account</a><button type="submit" class="btn-primary">Sign in</button></div></form></div></section>
