@page
@model CarMark.Pages.LoginModel
@{ ViewData["Title"] = "Entrar"; }
<link rel="stylesheet" href="~/css/OwnerCar.css" asp-append-version="true" />
<section class="owner-page"><div class="owner-shell"><div class="owner-heading"><p>CarMark</p><h1>Entrar na sua conta</h1><span>Acesse seus anúncios e continue comprando ou vendendo veículos.</span></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice notice-error">@Model.ErrorMessage</div> }
<form method="post" class="owner-form"><input type="hidden" asp-for="ReturnUrl" /><div class="form-grid"><label>E-mail<input asp-for="Input.Email" type="email" autocomplete="email" placeholder="voce@exemplo.com" /></label><label>Senha<input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Sua senha" /></label></div><div class="form-actions"><a asp-page="/Register" class="btn-secondary">Criar conta</a><button type="submit" class="btn-primary">Entrar</button></div></form></div></section>
