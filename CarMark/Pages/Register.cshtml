@page "/register"
@model CarMark.Pages.RegisterModel
@{ ViewData["Title"] = "Create account"; }
<link rel="stylesheet" href="~/css/OwnerCar.css" asp-append-version="true" />
<section class="owner-page"><div class="owner-shell"><div class="owner-heading"><p>Get started</p><h1>Create your account</h1><span>Choose whether you want to buy, sell, or both. You can sign in immediately after registering.</span></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice notice-error">@Model.ErrorMessage</div> }
<form method="post" class="owner-form"><div class="form-grid"><label>Name<input asp-for="Input.Name" maxlength="100" autocomplete="name" placeholder="Your name" /></label><label>Email<input asp-for="Input.Email" type="email" maxlength="160" autocomplete="email" placeholder="you@example.com" /></label><label>Phone<input asp-for="Input.Phone" maxlength="30" autocomplete="tel" placeholder="(00) 00000-0000" /></label><label>Password<input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="At least 6 characters" /></label><label>Account type<select asp-for="Input.AccountType"><option value="buyer">Buyer</option><option value="seller">Seller</option><option value="both">Buyer and seller</option></select></label></div><div class="form-actions"><a asp-page="/Login" class="btn-secondary">I already have an account</a><button type="submit" class="btn-primary">Create account</button></div></form></div></section>
