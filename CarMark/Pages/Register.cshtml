@page
@model CarMark.Pages.RegisterModel
@{ ViewData["Title"] = "Criar conta"; }
<link rel="stylesheet" href="~/css/OwnerCar.css" asp-append-version="true" />
<section class="owner-page"><div class="owner-shell"><div class="owner-heading"><p>Comece agora</p><h1>Crie sua conta</h1><span>Escolha se deseja comprar, vender, ou fazer ambos. Você poderá entrar imediatamente após o cadastro.</span></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <div class="notice notice-error">@Model.ErrorMessage</div> }
<form method="post" class="owner-form"><div class="form-grid"><label>Nome<input asp-for="Input.Name" maxlength="100" autocomplete="name" placeholder="Seu nome" /></label><label>E-mail<input asp-for="Input.Email" type="email" maxlength="160" autocomplete="email" placeholder="voce@exemplo.com" /></label><label>Telefone<input asp-for="Input.Phone" maxlength="30" autocomplete="tel" placeholder="(00) 00000-0000" /></label><label>Senha<input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" /></label><label>Perfil<select asp-for="Input.AccountType"><option value="buyer">Comprador</option><option value="seller">Vendedor</option><option value="both">Comprador e vendedor</option></select></label></div><div class="form-actions"><a asp-page="/Login" class="btn-secondary">Já tenho conta</a><button type="submit" class="btn-primary">Criar conta</button></div></form></div></section>
