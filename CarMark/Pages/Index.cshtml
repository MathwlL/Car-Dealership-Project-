@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}


<div class="Section-Front">
    <img class="background-hero" src="~/Imgs/beautiful-shot-snowy-mountain-sunset.jpg" />
    <div class="hero-text">
        <h1>The Future Is in Your Hands</h1>
        <p>Learn more about us</p>
        <a class="btn btn-light" asp-page="/Privacy">About Us</a>
    </div>

    <div class="hero-model">
        <model-viewer src="@Url.Content("~/models/Car.glb")"
                      auto-rotate
                      camera-controls
                      disable-zoom
                      touch-action="pan-y">
        </model-viewer>
    </div>
    <img class="Linhas1" src="~/Imgs/Effects/EffectRedLine.png" alt="Imagem Placeholder Comercial" />
    <img class="Linhas2" src="~/Imgs/Effects/EffectRedLine.png" alt="Imagem Placeholder Comercial" />
</div>

<hr /> <!-- Random ad area / add JavaScript later -->

<div class="Random-Ad">
    <img src="~/Imgs/ADPlaceHolder.png" alt="Imagem Placeholder Comercial" />
</div>

<hr /> <!-- Add more cars later -->

<h2>Discover our vehicles</h2>

<div class="filter-buttons">
    <button data-filter="all" class="active">All</button>
    <button data-filter="suv">SUVs</button>
    <button data-filter="sedan">Sedans</button>
</div>

<div class="Vehicles">
    <div class="card sedan">
        <img src="~/Imgs/Cars/HONDA_CIVIC.png" alt="Honda Civic">
            <h4>Honda Civic</h4>
        </div>

        <div class="card suv">
            <img src="~/Imgs/Cars/CHEVROLET_TRACKER.png" alt="Tracker">
                <h4>Tracker</h4>
            </div>

            <div class="card suv">
                <img src="~/Imgs/Cars/CHEVROLET_EQUINOX.png" alt="Equinox">
                    <h4>Equinox</h4>
                </div>

                <div class="card suv">
                    <img src="~/Imgs/Cars/CHEVROLET_TRAILBLAZER.png" alt="Trailblazer">
                        <h4>Trailblazer</h4>
                    </div>
                </div>
 
<hr /> <!-- Area de faq -->

<div class="faq-container">
    <div class="faq-title">Frequently Asked Questions</div>

    <div class="faq-item">
        <div class="faq-question">
            What is our service about?
            <span class="icon">⌄</span>
        </div>
        <div class="faq-answer">
            Lorem Epsum
        </div>
    </div>

<div class="faq-item">
        <div class="faq-question">
            How can I contact support?
        <span class="icon">⌄</span>
    </div>
      <div class="faq-answer">
            Lorem Epsum
       </div>
</div>

    <div class="faq-item">
        <div class="faq-question">
            Do you offer refunds?
            <span class="icon">⌄</span>
         </div>
        <div class="faq-answer">
            Lorem Epsum
        </div>
    </div>
</div>


                @section Scripts {
                    <script src="~/js/Home.js"></script>
                    <script type="module" src="https://unpkg.com/@@google/model-viewer/dist/model-viewer.min.js"></script>
                }
