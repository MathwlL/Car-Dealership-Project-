@page
@model CarMark.Pages.AddCarModel
@{ ViewData["Title"] = "Anunciar veículo"; }
<link rel="stylesheet" href="~/css/OwnerCar.css" asp-append-version="true" />
<section class="owner-page"><div class="owner-shell"><div class="owner-heading"><p>Área do vendedor</p><h1>Anuncie seu veículo</h1><span>As informações publicadas aqui aparecem automaticamente no catálogo de carros.</span></div>
<form method="post" enctype="multipart/form-data" class="owner-form"><div asp-validation-summary="ModelOnly" class="notice notice-error"></div><div class="form-grid"><label>Marca<input asp-for="Input.Company" maxlength="80" placeholder="Ex.: Honda" /></label><label>Modelo<input asp-for="Input.Model" maxlength="100" placeholder="Ex.: Civic Touring" /></label><label>Preço<input asp-for="Input.Price" min="0" type="number" placeholder="Ex.: 120000" /></label><label>Ano<input asp-for="Input.Year" min="1900" max="2100" type="number" /></label></div><label class="condition-toggle"><input asp-for="Input.Used" type="checkbox" /><span>Este veículo é usado</span></label><label class="wide-field">Detalhes<textarea asp-for="Input.Details" maxlength="3000" rows="7" placeholder="Condição, itens, manutenção e outras informações importantes."></textarea></label><label class="image-upload">Fotos do veículo<input asp-for="Images" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple /><small>JPEG, PNG, WebP ou GIF; até 5 MB por foto.</small></label><div class="form-actions"><a asp-page="/Carlist" class="btn-secondary">Ver catálogo</a><button type="submit" class="btn-primary">Publicar veículo</button></div></form></div></section>
